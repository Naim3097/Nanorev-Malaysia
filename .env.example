# NanoRev backend configuration. Copy to `.env` and fill in.
# (.env is gitignored — never commit real secrets.)

# ── Admin auth ────────────────────────────────────────────────────
# Admin panel / admin API key. The default "nanorev-admin" is public in
# this repo — ALWAYS set a long random value in production.
ADMIN_KEY=change-me-to-a-long-random-string

# ── Supabase (backend database + image storage) ───────────────────
# From your Supabase project: Settings → Data API (URL) and
# Settings → API Keys (service_role — SECRET, server-side only, never
# expose to the browser). Leave these blank to fall back to the local
# JSON file store for offline development.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket for product images (created by server/schema.sql).
SUPABASE_STORAGE_BUCKET=product-images

# ── LeanX payment gateway (real money) ────────────────────────────
# Only pages whose `paymentGateway` is set to "leanx" in the admin page
# builder use these; every other page stays on the simulated gateway.
# Credentials come from your LeanX collection (leanx.io dashboard).
#
# NOTE the host is .io — the .dev host is legacy and unstable.
LEANX_API_HOST=https://api.leanx.io
LEANX_AUTH_TOKEN=            # "Auth Token"      → sent as the auth-token header
LEANX_COLLECTION_UUID=       # "Collection UUID" → which account bills belong to
LEANX_WEBHOOK_SECRET=        # "Hash Key"        → HMAC secret verifying webhooks

# Public base URL used to build LeanX's redirect_url and callback_url. MUST be
# the externally reachable origin of THIS deployment — webhooks cannot reach
# localhost. On Vercel it defaults to the deployment URL, so it's only needed
# for a custom domain or a tunnelled local test.
# PUBLIC_BASE_URL=https://nanorev-malaysia.vercel.app

# ── Optional ──────────────────────────────────────────────────────
# PORT=3000
# JSON-file mode only: where the local db + uploads live.
# DATA_DIR=/data
