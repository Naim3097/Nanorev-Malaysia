# NanoRev backend configuration. Copy to `.env` and fill in.
# (.env is gitignored — never commit real secrets.)

# ── Admin auth ────────────────────────────────────────────────────
# Admin panel / admin API key. The default "nanorev-admin" is public in
# this repo — ALWAYS set a long random value in production.
ADMIN_KEY=change-me-to-a-long-random-string

# ── Supabase (backend database + image storage) ───────────────────
# From your Supabase project: Settings → Data API (URL) and
# Settings → API Keys (service_role — SECRET, server-side only, never
# expose to the browser). Leave these blank to fall back to the local
# JSON file store for offline development.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket for product images (created by server/schema.sql).
SUPABASE_STORAGE_BUCKET=product-images

# ── Optional ──────────────────────────────────────────────────────
# PORT=4000
# JSON-file mode only: where the local db + uploads live.
# DATA_DIR=/data
